# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here
API_V1_STR=/api/v1
SERVER_NAME=localhost
SERVER_HOST=http://localhost:8000
PROJECT_NAME=FraudShield AI

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraudshield
SQLALCHEMY_DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Security
SECURITY_BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=60 * 24 * 7  # 7 days
REFRESH_TOKEN_EXPIRE_DAYS=30

# First Superuser
FIRST_SUPERUSER=admin@fraudshield.ai
FIRST_SUPERUSER_PASSWORD=admin123

# Email (for password reset, notifications)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=no-reply@fraudshield.ai
EMAILS_FROM_NAME="FraudShield AI"

# ML Model
ML_MODEL_DIR=/app/models
MODEL_VERSION=1.0.0

# PGAdmin
PGADMIN_DEFAULT_EMAIL=admin@fraudshield.ai
PGADMIN_DEFAULT_PASSWORD=admin123

# Let's Encrypt (for Traefik)
LETSENCRYPT_EMAIL=admin@fraudshield.ai

# Monitoring
SENTRY_DSN=your-sentry-dsn-here

# Feature Flags
ENABLE_EMAIL_VERIFICATION=False
ENABLE_RATE_LIMITING=True
MAX_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Keys (for external services)
FRAUD_DETECTION_API_KEY=your-api-key-here

# External Services
FRAUD_DETECTION_API_URL=https://api.fraudservice.com/v1
